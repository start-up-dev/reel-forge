    "@fastify/multipart": "^9.0.3",
    "@fastify/sensible": "^6.0.1",
    "@google-cloud/storage": "^7.15.2",
    "@neondatabase/serverless": "^0.10.4",
    "@repo/types": "workspace:*",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.40.1",
    "fastify": "^5.2.0",
    "stripe": "^17.7.0",
    "zod": "^3.24.4"
